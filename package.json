{
  "name": "ecosystem-config",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "Central configuration and project registry for the developer ecosystem.",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "site:data": "node site/scripts/build-data.mjs",
    "site:dev": "pnpm site:data && vite --config site/vite.config.mts",
    "site:typecheck": "pnpm site:data && tsc -p site/tsconfig.json",
    "site:lint": "eslint site",
    "site:build": "pnpm site:data && tsc -p site/tsconfig.json && vite build --config site/vite.config.mts && node site/scripts/postbuild.mjs",
    "site:preview": "vite preview --config site/vite.config.mts",
    "docs:dev": "pnpm site:dev",
    "docs:build": "pnpm site:build",
    "docs:preview": "pnpm site:preview"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.1",
    "ajv": "^8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "markdown-it": "14.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
