{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config-ecosystem.invalid/schema/showcases.schema.json",
  "title": "Owner-selected showcase identities, independently of publication and placement",
  "type": "array",
  "items": { "$ref": "#/$defs/source" },
  "$defs": {
    "source": {
      "oneOf": [{ "$ref": "#/$defs/unqualified" }, { "$ref": "#/$defs/work" }]
    },
    "unqualified": {
      "type": "object", "required": ["kind", "id"], "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["project", "assessment", "engagement", "concept"] },
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
      }
    },
    "work": {
      "type": "object", "required": ["kind", "employerId", "id"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "work" },
        "employerId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
      }
    }
  }
}
